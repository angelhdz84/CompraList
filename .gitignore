# Dependencias de tooling: la app NO tiene dependencias en runtime, esto es solo
# para los tests (Playwright).
node_modules/

# Artefactos de Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# Proyecto Android de Capacitor: lo genera `cap add android` en cada build de
# GitHub Actions y no se versiona. Así el repo sigue siendo solo la web estática,
# sin build step, tal y como describe AGENTS.md.
android/
capacitor.config.json

# Directorio de escenario del APK: solo los ficheros que la app usa en ejecución.
# No se versiona porque lo crea el workflow en cada build.
www/

# Credenciales de firma: el keystore NUNCA se sube (va en GitHub Secrets).
*.keystore
*.jks
keystore.properties

# Entrega local del APK firmado y su respaldo de claves.
#
# OJO: esta carpeta contiene el keystore Y las contrasenas, y el repositorio es
# PÚBLICO. Si se quita esta regla o alguien hace `git add -f apk/`, las
# contrasenas de firma quedan publicadas y ya no se pueden cambiar (el secret
# está cifrado pero el fichero de texto con las contraseñas no).
#
# Copia de seguridad, no fuente del repo: para reconstruir el keystore, mira
# "APK de Android" en AGENTS.md.
apk/
*.apk
CLAVES-*.txt
compralist*.keystore

# Sistema y editores
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Logs sueltos
*.log
npm-debug.log*
