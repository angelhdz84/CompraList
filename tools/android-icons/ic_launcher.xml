<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono adaptativo de Android (API 26+). Se copia tambien como ic_launcher_round
  porque hay fabricantes que lo piden por separado. Sin este fichero, el launcher
  aplica su mascara al PNG rasterizado y el icono queda encogido dentro de un
  borde, que es el error clasico del iconoadaptive mal hecho.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
